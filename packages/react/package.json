{
  "name": "@window-manager/react",
  "version": "0.1.1",
  "description": "React provider and hooks for @window-manager/core.",
  "license": "Apache-2.0",
  "keywords": [
    "window-manager",
    "desktop",
    "react",
    "headless",
    "typescript"
  ],
  "homepage": "https://github.com/SiriusBinaryDev/window-manager-core#readme",
  "bugs": {
    "url": "https://github.com/SiriusBinaryDev/window-manager-core/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SiriusBinaryDev/window-manager-core.git",
    "directory": "packages/react"
  },
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.tsx --format esm --dts",
    "test": "vitest run",
    "lint": "eslint src --ext .ts,.tsx",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "dependencies": {
    "@window-manager/core": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "react-dom": "^19.1.0",
    "tsup": "^8.5.0"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  }
}
