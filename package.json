{
  "name": "window-manager-core-monorepo",
  "private": true,
  "version": "0.1.0",
  "description": "Headless TypeScript packages for building workspace-based window interfaces in web apps.",
  "packageManager": "pnpm@10.13.1",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SiriusBinaryDev/window-manager-core.git"
  },
  "bugs": {
    "url": "https://github.com/SiriusBinaryDev/window-manager-core/issues"
  },
  "homepage": "https://github.com/SiriusBinaryDev/window-manager-core#readme",
  "engines": {
    "node": ">=20.0.0"
  },
  "pnpm": {
    "overrides": {
      "postcss": "^8.5.23",
      "vite": "^6.4.3",
      "@babel/core": "^7.29.6",
      "js-yaml@3": "^3.15.1",
      "js-yaml@4": "^4.3.1",
      "brace-expansion@1": "^1.1.16",
      "brace-expansion@5": "^5.0.7",
      "esbuild@0.27": "^0.28.1",
      "ws@8": "^8.21.0"
    }
  },
  "scripts": {
    "build": "pnpm -r build",
    "build:packages": "pnpm --filter @window-manager/core --filter @window-manager/react build",
    "changeset": "changeset",
    "dev": "pnpm --filter @window-manager/playground dev",
    "release": "pnpm build && changeset publish",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "version-packages": "changeset version",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@changesets/cli": "^2.30.0",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.1",
    "jsdom": "^26.1.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.3",
    "vitest": "^3.2.6"
  }
}
