{
    "name":  "window-manager-core-monorepo",
    "private":  true,
    "version":  "0.1.0",
    "packageManager":  "pnpm@10.13.1",
    "scripts":  {
                    "build":  "pnpm -r build",
                    "changeset":  "changeset",
                    "dev":  "pnpm --filter @window-manager/playground dev",
                    "release":  "pnpm build \u0026\u0026 changeset publish",
                    "test":  "pnpm -r test",
                    "lint":  "pnpm -r lint",
                    "typecheck":  "pnpm -r typecheck",
                    "version-packages":  "changeset version",
                    "format":  "prettier --write ."
                },
    "devDependencies":  {
                            "@changesets/cli":  "^2.30.0",
                            "@typescript-eslint/eslint-plugin":  "^8.30.1",
                            "@typescript-eslint/parser":  "^8.30.1",
                            "eslint":  "^8.57.1",
                            "eslint-config-prettier":  "^10.1.1",
                            "prettier":  "^3.5.3",
                            "typescript":  "^5.8.3",
                            "vitest":  "^3.1.1"
                        }
}
