{
  "name": "window-manager-core-monorepo",
  "private": true,
  "version": "0.1.0",
  "description": "Headless TypeScript packages for building workspace-based window interfaces in web apps.",
  "packageManager": "pnpm@10.13.1",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SiriusBinaryDev/window-manager-core.git"
  },
  "bugs": {
    "url": "https://github.com/SiriusBinaryDev/window-manager-core/issues"
  },
  "homepage": "https://github.com/SiriusBinaryDev/window-manager-core#readme",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "build:packages": "pnpm --filter @window-manager/core --filter @window-manager/react build",
    "changeset": "changeset",
    "dev": "pnpm --filter @window-manager/playground dev",
    "release": "pnpm build && changeset publish",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "version-packages": "changeset version",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@changesets/cli": "^2.30.0",
    "@typescript-eslint/eslint-plugin": "^8.30.1",
    "@typescript-eslint/parser": "^8.30.1",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.1",
    "jsdom": "^26.1.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.3",
    "vitest": "^3.1.1"
  }
}
